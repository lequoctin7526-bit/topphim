# CINEORA Backend Configuration

NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cineora?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Secrets
JWT_ACCESS_SECRET="cineora_jwt_access_secret_production_ready_token_2026_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cineora_jwt_refresh_secret_production_ready_token_2026_key"
JWT_REFRESH_EXPIRES_IN="30d"

# Playback HMAC Token Secret
PLAYBACK_SIGNING_KEY="cineora_playback_hmac_sha256_signing_key_secure_vault"
PLAYBACK_URL_TTL_SECONDS=7200

# Metadata External Provider (TMDB - Public Attribution compliant)
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"

# CDN & Origin Base URLs
CDN_STREAM_BASE_URL="https://cdn.cineora.tv"

# CORS
CORS_ORIGINS="*"
